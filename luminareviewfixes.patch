+    select: { id: true, instructorId: true, status: true },
+  });
+
+  if (!course) throw new Error('NOT_FOUND');
+  if (user.role !== 'ADMIN' && course.instructorId !== user.id) {
+    throw new Error('FORBIDDEN');
+  }
+
+  return { user, course };
